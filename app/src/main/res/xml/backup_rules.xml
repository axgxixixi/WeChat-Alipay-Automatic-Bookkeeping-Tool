<?xml version="1.0" encoding="utf-8"?><!--
   Android 11 及以下的备份规则(Auto Backup)。

   与 data_extraction_rules.xml 保持一致: 明文账单库与认证 token 都不备份。
   原因同前 —— 账单是敏感数据, 而 token 的 Keystore 密钥不随备份迁移,
   备份恢复后只会得到一个解不开的密文。
-->
<full-backup-content>
    <exclude domain="database" path="accounting.db" />
    <exclude domain="file" path="datastore/auth_prefs.preferences_pb" />
</full-backup-content>